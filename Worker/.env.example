# Worker 단독 실행 시 사용할 실행 환경 이름
# 예: local, dev, staging, production
APP_ENV=local

# FastAPI 앱이 사용할 내부 포트
WORKER_CONTAINER_PORT=8000

# Kafka consumer 루프 활성화 여부
# request topic을 소비할 때는 true
# HTTP OCR만 테스트할 때는 false 가능
KAFKA_ENABLED=true

# Worker 프로세스에서 접근할 Kafka bootstrap 서버
# Docker compose: kafka:9092
# 단독 로컬 테스트: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 영수증 OCR 파이프라인용 Kafka 토픽
KAFKA_RECEIPT_REQUEST_TOPIC=receipt-ocr-request
KAFKA_RECEIPT_RESULT_TOPIC=receipt-ocr-result
KAFKA_RECEIPT_RETRY_TOPIC=receipt-ocr-retry
KAFKA_RECEIPT_DLQ_TOPIC=receipt-ocr-dlq

# 여행 사진 처리 consumer는 실제 처리 로직 구현 후 활성화
KAFKA_PHOTO_ENABLED=false
KAFKA_PHOTO_REQUEST_TOPIC=photo-processing-request
KAFKA_PHOTO_RESULT_TOPIC=photo-processing-result
KAFKA_PHOTO_RETRY_TOPIC=photo-processing-retry
KAFKA_PHOTO_DLQ_TOPIC=photo-processing-dlq
KAFKA_PHOTO_CONSUMER_GROUP=yeoun-worker-photo

# Kafka consumer group 및 offset 시작 정책
KAFKA_CONSUMER_GROUP=yeoun-worker-receipt
KAFKA_AUTO_OFFSET_RESET=earliest

# DLQ로 보내기 전 최대 재시도 횟수
KAFKA_MAX_RETRY_ATTEMPTS=3

# GMS / Gemini 멀티모달 설정
# 실제 비밀값은 .env에만 넣고 커밋 금지
GMS_API_KEY=your_gms_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
