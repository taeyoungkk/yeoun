# Worker 실행 환경 이름
# 예: local, dev, staging, production
APP_ENV=local

# FastAPI 내부 포트
WORKER_CONTAINER_PORT=8000

# 영수증 OCR Kafka consumer 활성화 여부
KAFKA_ENABLED=true

# Kafka bootstrap 서버
# Docker compose: kafka:9092
# 로컬 단독 테스트: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 영수증 OCR 토픽
KAFKA_RECEIPT_REQUEST_TOPIC=receipt-ocr-request
KAFKA_RECEIPT_RESULT_TOPIC=receipt-ocr-result
KAFKA_RECEIPT_RETRY_TOPIC=receipt-ocr-retry
KAFKA_RECEIPT_DLQ_TOPIC=receipt-ocr-dlq

# 여행 사진 처리 토픽
# 전체 파이프라인 완료 전까지는 비활성화 권장
KAFKA_PHOTO_ENABLED=false
KAFKA_PHOTO_REQUEST_TOPIC=photo-processing-request
KAFKA_PHOTO_RESULT_TOPIC=photo-processing-result
KAFKA_PHOTO_RETRY_TOPIC=photo-processing-retry
KAFKA_PHOTO_DLQ_TOPIC=photo-processing-dlq
KAFKA_PHOTO_CONSUMER_GROUP=yeoun-worker-photo

# Consumer group 및 offset 시작 정책
KAFKA_CONSUMER_GROUP=yeoun-worker-receipt
KAFKA_AUTO_OFFSET_RESET=earliest

# DLQ 이동 전 최대 재시도 횟수
KAFKA_MAX_RETRY_ATTEMPTS=3

# storageKey만 전달받았을 때 원본 이미지를 조회할 기본 URL
IMAGE_BASE_URL=http://localhost/images

# 썸네일 생성 및 S3 업로드 설정
PHOTO_THUMBNAIL_FORMAT=JPEG
PHOTO_THUMBNAIL_MAX_SIZE=512
PHOTO_THUMBNAIL_QUALITY=85
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_THUMBNAIL_PREFIX=thumbnails
AWS_S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-northeast-2.amazonaws.com

# GMS / Gemini 설정
GMS_API_KEY=your_gms_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
