# PostgreSQL 접속 계정명
POSTGRES_USER=yeoun

# PostgreSQL 접속 비밀번호
POSTGRES_PASSWORD=yeoun_pass

# PostgreSQL 데이터베이스 이름
POSTGRES_DB=yeoun_db

# Redis 비밀번호
REDIS_PASSWORD=yeoun_redis_pass

# API 이미지 태그
# 로컬 테스트: yeoun-api:local
# EC2 배포: CI가 만든 registry/repository:tag
API_IMAGE=yeoun-api:local

# API 컨테이너 내부 포트
API_CONTAINER_PORT=8080

# 로컬에서 API 컨테이너를 바인딩할 호스트 포트
API_HOST_PORT=8080

# node1 nginx가 외부에 노출할 HTTP 포트
NGINX_HTTP_PORT=80

# HTTPS 포트
NGINX_HTTPS_PORT=443

# nginx 서버 이름
# 로컬 테스트: localhost
# EC2: 실제 도메인 사용 권장
NGINX_SERVER_NAME=localhost

# deploy-node1.sh에서 사용하는 헬스체크 URL
NODE1_HEALTHCHECK_URL=http://localhost/actuator/health
