# node2 Kafka 브로커의 클러스터 ID
KAFKA_CLUSTER_ID=yeoun-kafka-cluster-1

# 다른 서비스가 Kafka에 접속할 때 사용할 호스트명 또는 IP
# 로컬 Docker 테스트: localhost
# EC2: 배포 방식에 맞는 private IP 또는 public DNS
KAFKA_ADVERTISED_HOST=localhost

# 호스트 머신에서 외부에 노출할 Kafka 포트
KAFKA_EXTERNAL_PORT=9092

# Worker 이미지 태그
# 로컬 테스트: yeoun-worker:local
# EC2 배포: CI가 만든 registry/repository:tag
WORKER_IMAGE=yeoun-worker:local

# Worker FastAPI 앱의 컨테이너 내부 포트
WORKER_CONTAINER_PORT=8000

# 로컬 compose에서 Worker를 바인딩할 호스트 포트
WORKER_HOST_PORT=8000

# Worker 내부 Kafka consumer 활성화 여부
# 비동기 OCR 처리 사용 시 true
# HTTP 단독 테스트만 할 때는 false 가능
KAFKA_ENABLED=true

# Worker 컨테이너 내부에서 보이는 Kafka bootstrap 서버
# 현재 compose 구조에서는 kafka:9092 유지
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# 영수증 OCR 파이프라인용 Kafka 토픽
KAFKA_RECEIPT_REQUEST_TOPIC=receipt-ocr-request
KAFKA_RECEIPT_RESULT_TOPIC=receipt-ocr-result
KAFKA_RECEIPT_RETRY_TOPIC=receipt-ocr-retry
KAFKA_RECEIPT_DLQ_TOPIC=receipt-ocr-dlq

# Worker 영수증 consumer group id
KAFKA_CONSUMER_GROUP=yeoun-worker-receipt

# 커밋된 offset이 없을 때 시작 위치
# earliest 또는 latest 중 선택
KAFKA_AUTO_OFFSET_RESET=earliest

# DLQ로 보내기 전 최대 재시도 횟수
KAFKA_MAX_RETRY_ATTEMPTS=3

# GMS / Gemini 멀티모달 호출용 API 키
# 실제 비밀값은 .env에만 넣고 커밋 금지
GMS_API_KEY=your_gms_api_key_here

# 영수증 추출에 사용할 Gemini 모델과 엔드포인트
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com/v1beta

# 이미지 다운로드 및 Gemini 요청 타임아웃(초)
GEMINI_TIMEOUT_SECONDS=60

# node2 nginx가 외부에 노출할 HTTP 포트
NGINX_HTTP_PORT=8081

# HTTPS 포트
NGINX_HTTPS_PORT=443

# nginx 서버 이름
NGINX_SERVER_NAME=localhost

# deploy-node2.sh에서 사용하는 헬스체크 URL
NODE2_HEALTHCHECK_URL=http://localhost/
