# 노션의 Backend - env를 참고하세요.

# Database
DB_URL=jdbc:postgresql://localhost:5432/yeoun
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=__CHANGE_ME_TO_A_LONG_RANDOM_SECRET__
JWT_ACCESS_EXPIRE_SECONDS=1800
JWT_REFRESH_EXPIRE_SECONDS=1209600

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Google OAuth
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
# Optional legacy fallback for single-client setups
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# SSAFY Finance API
FINANCE_ENABLED=true
FINANCE_BASE_URL=https://finopenapi.ssafy.io
FINANCE_INSTITUTION_CODE=00100
FINANCE_FINTECH_APP_NO=001
FINANCE_API_KEY=
FINANCE_SYNC_RANGE_DAYS=365

# Invite Link
APP_INVITE_BASE_URL=https://your-frontend-domain/invites

# Kakao Local API
KAKAO_LOCAL_ENABLED=false
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=
KAKAO_LOCAL_TIMEOUT_SECONDS=3
KAKAO_LOCAL_SEARCH_RADIUS_METERS=120
KAKAO_LOCAL_MAX_CANDIDATES=5
KAKAO_LOCAL_SELECTION_DISTANCE_METERS=150
KAKAO_LOCAL_CATEGORY_GROUP_CODES=FD6,CE7,AT4,CT1,AD5,MT1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRIP_LOCATION_LOG_TOPIC=trip-location-log-batch
APP_PHOTO_PROCESSING_PRESIGNED_EXPIRE_SECONDS=900

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
