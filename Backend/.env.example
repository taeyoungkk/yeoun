# 노션의 Backend - env를 참고하세요.

# Database
DB_URL=jdbc:postgresql://localhost:5432/yeoun
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=__CHANGE_ME_TO_A_LONG_RANDOM_SECRET__
JWT_ACCESS_EXPIRE_SECONDS=1800
JWT_REFRESH_EXPIRE_SECONDS=1209600

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# Invite Link
APP_INVITE_BASE_URL=https://your-frontend-domain/invites

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
